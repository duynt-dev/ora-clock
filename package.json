{
  "name": "ora-clock",
  "productName": "Ora Clock",
  "version": "1.0.0",
  "description": "A beautiful desktop clock with flip/analog/word faces, liquid glass themes, Spotify and YouTube playback.",
  "main": "src/main/main.js",
  "author": "Ora",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node tools/run.js --debug",
    "selftest": "node tools/run.js --debug --selftest",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.ora.clock",
    "productName": "Ora Clock",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ora Clock"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
